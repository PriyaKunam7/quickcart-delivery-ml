APP_ENV=dev
AWS_REGION=us-west-2
MODEL_BUCKET=quickcart-models-dev
MODEL_KEY=models/delivery/latest/model.joblib
LOG_LEVEL=INFO
# --- OpsAssist LLM provider settings ---
# Set LLM_PROVIDER to select which backend is active. Only fill in the
# credential block matching that provider -- the others can stay blank.
# Never commit real values here; this file only documents which
# variables exist. Copy to .env and fill in real values locally.

LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=

# AWS Bedrock
AWS_BEDROCK_REGION=
AWS_ACCESS_KEY_ID=

